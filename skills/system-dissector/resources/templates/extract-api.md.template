## 8. Machine-readable (YAML) — consumed by `neodoo-integrate`

```yaml
# extract/api.md → machine-readable form
# Parsed by neodoo-integrate Phase 5 (OPT-IN) to map endpoints to consumer contracts.
api:
  outbound:
    - endpoint: https://api.example.com/v1/resource
      method: POST
      auth: bearer | oauth2 | hmac | mTLS | api-key | none
      rate_limit: "<n rps | unbounded | unknown>"
      equivalent_in_neoai: <null | "apps/web/server/api/<path>.ts">
      port_strategy: reference | wrap | extract-pattern | drop-in | source-port
      license: <SPDX identifier>
      evidence: <path:line>
  inbound:
    - endpoint: POST /v1/webhooks/incoming
      method: POST
      auth: hmac
      rate_limit: "1000 rps"
      equivalent_in_neoai: <null | path>
      port_strategy: reference
      license: <SPDX>
      evidence: <path:line>
  sdks:
    - name: <sdk-name>
      language: go | ts | py | rs | java
      repo: <github url>
      license: <SPDX>
      port_strategy: drop-in | source-port | wrap
  internal_rpc:
    - caller: <service-name>
      callee: <service-name>
      transport: grpc | http | queue
      auth: mTLS | jwt | none
  deprecated:
    - endpoint: <path>
      deprecated_since: <YYYY-MM-DD>
      replacement: <path>
```

